# Application Configuration
SPRING_PROFILES_ACTIVE=dev
PORT=8082

# Docker Compose (docker compose up) reads these; every value is optional
# DB_NAME=car_rental
# DB_PORT=5433
# APP_PORT=8082
# MANAGEMENT_HOST_PORT=8081

# Management port (actuator health, info and prometheus; never expose publicly)
MANAGEMENT_PORT=8081

# Database session timeouts applied to every pooled connection (Flyway is exempt)
# DB_STATEMENT_TIMEOUT=30s
# DB_LOCK_TIMEOUT=5s
# DB_IDLE_IN_TRANSACTION_TIMEOUT=60s

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5433/car_rental
DB_USERNAME=postgres
DB_PASSWORD=your-postgresql-password
DB_SCHEMA=car_rental

# CORS (comma separated https origins, required when SPRING_PROFILES_ACTIVE=prod)
CORS_ORIGINS=https://your-web-domain.example
# Safe default: the API trusts no forwarded address and every client is keyed by its socket address.
TRUST_FORWARDED_HEADERS=false
TRUSTED_PROXY_HOPS=1
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_CIDRS=
# Opt in only when a known proxy sets the end-user address and the API is reachable from that proxy alone.
# Web server (BFF) forwarding the address in X-Client-IP: list only the BFF network, never a wide range.
# TRUSTED_CLIENT_IP_HEADER=X-Client-IP
# TRUSTED_PROXY_CIDRS=<BFF network CIDR>
# One reverse proxy appending to X-Forwarded-For: TRUST_FORWARDED_HEADERS=true, TRUSTED_PROXY_HOPS=1 and its CIDR.
# Behind a CDN, TRUSTED_PROXY_HOPS=2, or the CDN header with origin access restricted to the CDN.

# JWT Configuration
JWT_SECRET=your-secure-secret-key-here-minimum-256-bits
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_REFRESH_REUSE_GRACE_SECONDS=10

EXCHANGE_RATE_API_KEY=your-api-key-here

# OAuth2 Configuration
APP_BASE_URL=http://localhost:3000

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth2
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth2 State Secret (for CSRF protection)
OAUTH2_STATE_SECRET=your-secure-state-secret-minimum-32-chars

# Stripe Configuration
STRIPE_API_KEY=sk_test_your-stripe-api-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_METADATA_ENVIRONMENT=dev

# Email Configuration
EMAIL_FROM=noreply@example.com
EMAIL_ENABLED=true

# SendGrid SMTP (Production only - leave empty for development)
SENDGRID_HOST=smtp.sendgrid.net
SENDGRID_PORT=587
SENDGRID_USERNAME=apikey
SENDGRID_API_KEY=your-sendgrid-api-key

# Cloudflare R2 Configuration (Production only - leave empty for development)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# JVM Options (Docker only - ignored when running with Maven)
# Uncomment and adjust based on your container memory:
# JAVA_OPTS=-Xmx400m -Xms256m   # 512MB container (Railway free)
# JAVA_OPTS=-Xmx768m -Xms512m   # 1GB container
# JAVA_OPTS=-Xmx1536m -Xms512m  # 2GB container